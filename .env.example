# Copy to .env (cp .env.example .env) and edit. docker compose and the Makefile read .env from this directory.

# Registry host the image is pulled from. ghcr.io is upstream; mirror-ghcr.pkg.shecan.ir mirrors it.
THRONE_REGISTRY=ghcr.io
# THRONE_REGISTRY=mirror-ghcr.pkg.shecan.ir

# Image tag: a release such as 1.4.1, or latest.
THRONE_VERSION=1.4.1

# Address the mixed (HTTP + SOCKS) inbound on port 2080 listens on, applied on every start.
# 0.0.0.0 lets the 2080 port mapping reach it; 127.0.0.1 keeps it inside the container.
# Leave empty to keep whatever is set in Throne (thronectl settings / web UI).
THRONE_INBOUND_ADDRESS=0.0.0.0

# Web UI password. When set, it replaces the stored one (and `thronectl web passwd` has no effect).
# Leave empty to use the password printed on first start, or one set with `thronectl web passwd`.
THRONE_WEB_PASSWORD=admin1234
